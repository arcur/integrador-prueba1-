<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro - TechStore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/registro.css">
    <link rel="icon" type="imagen/png" href="/img/techstore-Photoroom.png">
    </head>
<body>
 <a href="/" class="logo-empresa">
        <img src="/img/techstore-Photoroom.png" alt="Logo TechStore"> </a>

    <div class="auth-container">
        <div class="auth-box">
            <h2>Crear Cuenta</h2>

            <% if (locals.errors && errors.length > 0) { %>
                <div class="alert alert-danger" role="alert">
                    <div> <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div>
                        <h6 style="margin-bottom: 5px;">Por favor, corrige los errores:</h6>
                        <ul>
                            <% errors.forEach(err => { %>
                                <li><%= err %></li>
                            <% }) %>
                        </ul>
                    </div>
                </div>
            <% } %>

            <form action="/registro" method="POST" novalidate>
                <div class="form-registro-grid">
                    <div class="form-group">
                        <label for="nombre">Nombre</label>
                        <input type="text" id="nombre" name="nombre" required
                               value="<%= locals.formData ? formData.nombre : '' %>" pattern="[A-Za-z\sñáéíóúÁÉÍÓÚ]+" title="Solo letras">
                    </div>
                    <div class="form-group">
                        <label for="apellido_paterno">Apellido Paterno</label>
                        <input type="text" id="apellido_paterno" name="apellido_paterno" required
                               value="<%= locals.formData ? formData.apellido_paterno : '' %>" pattern="[A-Za-z\sñáéíóúÁÉÍÓÚ]+" title="Solo letras">
                    </div>
                     <div class="form-group">
                        <label for="apellido_materno">Apellido Materno</label>
                        <input type="text" id="apellido_materno" name="apellido_materno" required
                               value="<%= locals.formData ? formData.apellido_materno : '' %>" pattern="[A-Za-z\sñáéíóúÁÉÍÓÚ]+" title="Solo letras">
                    </div>
                    <div class="form-group">
                        <label for="numero_dni">DNI</label>
                        <input type="text" id="numero_dni" name="numero_dni" required
                               value="<%= locals.formData ? formData.numero_dni : '' %>" pattern="[0-9]{8}" title="8 dígitos numéricos" maxlength="8">
                    </div>
                     <div class="form-group">
                        <label for="telefono">Teléfono (Opcional)</label>
                        <input type="tel" id="telefono" name="telefono"
                               value="<%= locals.formData ? formData.telefono : '' %>" pattern="[0-9+]*" title="Solo números y +" maxlength="15">
                    </div>
                    <div class="form-group">
                        <label for="fecha_nacimiento">Fecha de Nacimiento</label>
                        <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" required
                               value="<%= locals.formData ? formData.fecha_nacimiento : '' %>">
                    </div>
                    <div class="form-group full-width">
                        <label for="correo">Correo Electrónico</label>
                        <input type="email" id="correo" name="correo" required
                               value="<%= locals.formData ? formData.correo : '' %>">
                    </div>
                     <div class="form-group">
                        <label for="usuario">Nombre de Usuario</label>
                        <input type="text" id="usuario" name="usuario" required
                               value="<%= locals.formData ? formData.usuario : '' %>">
                    </div>
                    <div class="form-group">
                        <label for="contraseña">Contraseña</label>
                         <div style="position: relative;">
                            <input type="password" id="contraseña" name="contraseña" required minlength="6" title="Mínimo 6 caracteres">
                            <i class="bi bi-eye-slash toggle-password" id="togglePassword"></i>
                        </div>
                    </div>
                </div> <button type="submit" class="btn">Registrarse</button>
            </form>

            <div class="switch">
                <span>¿Ya tienes una cuenta?</span>
                <a href="/login">Inicia Sesión</a>
            </div>
        </div>
    </div>

   
     <script>
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('contraseña');

        if (togglePassword && passwordInput) {
            togglePassword.addEventListener('click', function () {
                // Cambiar tipo de input
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                // Cambiar icono
                this.classList.toggle('bi-eye');
                this.classList.toggle('bi-eye-slash');
            });
        }
    </script>


</body>
</html>