<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechStore - Mis Tarjetas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="css/style_base.css"> 
    
    </head>
<body>

    <div class="container-fluid">
        <div class="row">
            <div class="col-auto px-0">
                <%- include('partials/intranet_sidebar') %>
            </div>

            <div class="col py-3">
                <header class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                    <h1 class="futuristic-title fs-4">           </h1>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="theme-toggle">
                        <label class="form-check-label" for="theme-toggle">☀️ Modo Claro</label>
                    </div>
                </header>

                <main>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                         <h2 class="futuristic-title mb-0">Métodos de Pago Guardados <i class="bi bi-credit-card-fill"></i></h2>
                         <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAgregarTarjeta">
                             <i class="bi bi-plus-lg"></i> Agregar Nueva Tarjeta
                         </button>
                    </div>

                    <div class="row row-cols-1 row-cols-lg-2 g-4">
                        
                        <div class="col">
                            <div class="card bg-secondary border-primary border-2 h-100"> <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <i class="bi bi-credit-card-2-front-fill fs-1" style="color: var(--bs-primary-text-emphasis);"></i>
                                            <span class="badge bg-primary ms-2">Predeterminada</span>
                                        </div>
                                        <div class="dropdown">
                                             <button class="btn btn-sm btn-outline-secondary border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><button class="dropdown-item text-danger" type="button"><i class="bi bi-trash me-2"></i>Eliminar</button></li>
                                            </ul>
                                        </div>
                                    </div>
                                    <h5 class="card-title">Visa **** **** **** 1234</h5>
                                    <p class="card-text text-white-50">Expira: 12/2028</p>
                                    <p class="card-text small mt-auto text-white-50">Agregada el 20 Oct, 2025</p>
                                </div>
                            </div>
                        </div>

                        <div class="col">
                            <div class="card bg-secondary border-0 h-100">
                                 <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <i class="bi bi-credit-card-2-front fs-1 text-white-50"></i>
                                        <div class="dropdown">
                                             <button class="btn btn-sm btn-outline-secondary border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                 <li><button class="dropdown-item" type="button"><i class="bi bi-star-fill me-2"></i>Marcar como predeterminada</button></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><button class="dropdown-item text-danger" type="button"><i class="bi bi-trash me-2"></i>Eliminar</button></li>
                                            </ul>
                                        </div>
                                    </div>
                                    <h5 class="card-title">Mastercard **** **** **** 5678</h5>
                                    <p class="card-text text-white-50">Expira: 08/2026</p>
                                    <p class="card-text small mt-auto text-white-50">Agregada el 15 Sep, 2025</p>
                                </div>
                            </div>
                        </div>

                        </div> </main>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalAgregarTarjeta" tabindex="-1" aria-labelledby="modalAgregarTarjetaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h1 class="modal-title fs-5 futuristic-title" id="modalAgregarTarjetaLabel">
                        <i class="bi bi-credit-card-2-front me-2"></i>Agregar Nueva Tarjeta
                    </h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="mb-3">
                            <label for="cardNumber" class="form-label">Número de Tarjeta</label>
                            <input type="text" class="form-control" id="cardNumber" placeholder="**** **** **** ****" required>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label for="cardExpiry" class="form-label">Fecha de Expiración</label>
                                <input type="text" class="form-control" id="cardExpiry" placeholder="MM/AA" required>
                            </div>
                            <div class="col">
                                <label for="cardCvc" class="form-label">CVC</label>
                                <input type="text" class="form-control" id="cardCvc" placeholder="123" required>
                            </div>
                        </div>
                         <div class="mb-3">
                            <label for="cardName" class="form-label">Nombre en la Tarjeta</label>
                            <input type="text" class="form-control" id="cardName" placeholder="Juan Pérez" required>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="defaultCardCheck">
                            <label class="form-check-label" for="defaultCardCheck">
                                Hacer esta mi tarjeta predeterminada
                            </label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Tarjeta</button> 
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script src="js/app_sidebar_bootstrap.js"></script>

</body>
</html>