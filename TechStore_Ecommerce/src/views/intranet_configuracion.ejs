<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechStore - Configuración</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" type="/image/png" href="/img/techstore-Photoroom.png">
    <link rel="stylesheet" href="/css/style_base.css">
</head>
<body>

    <div class="container-fluid">
        <div class="row">
            <div class="col-auto px-0">
                <%- include('partials/intranet_sidebar') %>
            </div>

            <div class="col py-3">
                <header class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                    <h1 class="futuristic-title fs-4"> </h1>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="theme-toggle">
                        <label class="form-check-label" for="theme-toggle">☀️ Modo Claro</label>
                    </div>
                </header>

                <main>
                    <h2 class="futuristic-title mb-4">Configuración de Cuenta ⚙️</h2>

                    <%# --- Alertas de Éxito/Error --- %>
                    <% if (locals.error_msg && error_msg.length > 0) { %>
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i> <%= error_msg %>
                        </div>
                    <% } %>
                    <% if (locals.success_msg && success_msg.length > 0) { %>
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle-fill"></i> <%= success_msg %>
                        </div>
                    <% } %>
                    <%# --- Fin Alertas --- %>


                    <div class="row">
                        <div class="col-lg-6 mb-4">
                            <div class="card bg-secondary border-0 h-100">
                                <div class="card-body">
                                    <h5 class="card-title mb-3">Datos Personales</h5>
                                    
                                    <%# --- FORMULARIO DE DATOS --- %>
                                    <form action="/intranet/configuracion/actualizar-datos" method="POST">
                                        
                                        <div class="mb-3">
                                            <label for="nombre" class="form-label">Nombre</label>
                                            <input type="text" class="form-control" id="nombre" name="nombre" value="<%= datosUsuario.nombre %>" required>
                                        </div>
                                        <div class="mb-3">
                                            <label for="apellido_paterno" class="form-label">Apellido Paterno</label>
                                            <input type="text" class="form-control" id="apellido_paterno" name="apellido_paterno" value="<%= datosUsuario.apellido_paterno %>" required>
                                        </div>
                                        <div class="mb-3">
                                            <label for="apellido_materno" class="form-label">Apellido Materno</label>
                                            <input type="text" class="form-control" id="apellido_materno" name="apellido_materno" value="<%= datosUsuario.apellido_materno %>" required>
                                        </div>

                                        <div class="mb-3">
                                            <label for="email" class="form-label">Correo Electrónico (No editable)</label>
                                            <input type="email" class="form-control" id="email" value="<%= datosUsuario.correo %>" readonly disabled>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label for="phone" class="form-label">Número de Teléfono</label>
                                            <input type="tel" class="form-control" id="phone" name="telefono" value="<%= datosUsuario.telefono %>">
                                        </div>
                                        
                                        <button type="submit" class="btn btn-primary mt-2">Guardar Cambios</button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6 mb-4">
                            <div class="card bg-secondary border-0 h-100">
                                <div class="card-body">
                                    <h5 class="card-title mb-3">Seguridad</h5>
                                    
                                    <%# --- FORMULARIO DE CONTRASEÑA --- %>
                                    <form action="/intranet/configuracion/cambiar-password" method="POST">
                                        <div class="mb-3">
                                            <label for="passCurrent" class="form-label">Contraseña Actual</label>
                                            <input type="password" class="form-control" id="passCurrent" name="passCurrent" placeholder="Ingresa tu contraseña actual" required>
                                        </div>
                                        <div class="mb-3">
                                            <label for="passNew" class="form-label">Nueva Contraseña</label>
                                            <input type="password" class="form-control" id="passNew" name="passNew" placeholder="Mínimo 8 caracteres" required minlength="6">
                                        </div>
                                        <div class="mb-3">
                                            <label for="passConfirm" class="form-label">Confirmar Nueva Contraseña</label>
                                            <input type="password" class="form-control" id="passConfirm" name="passConfirm" placeholder="Repite la nueva contraseña" required minlength="6">
                                        </div>
                                        <button type="submit" class="btn btn-primary mt-2">Cambiar Contraseña</button>
                                    </form>
                                </div>
                            </div>
                        </div>

                       <div class="col-12 mb-4">
                            <div class="card bg-secondary border-0">
                                <div class="card-body">
                                    <h5 class="card-title mb-3">Direcciones de Envío</h5>
                                    
                                    <% if (direcciones && direcciones.length > 0) { %>
                                        <% direcciones.forEach(dir => { %>
                                            <div class="p-3 rounded border-start border-4 mb-3 position-relative" 
                                                 style="background-color: var(--bs-body-bg); border-color: <%= dir.es_predeterminada ? 'var(--bs-primary)' : '#6c757d' %> !important;">
                                                
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <h6 class="mb-1">
                                                            <%= dir.ciudad %>
                                                            <% if (dir.es_predeterminada) { %>
                                                                <span class="badge bg-primary ms-2">Predeterminada</span>
                                                            <% } %>
                                                        </h6>
                                                        <p class="mb-0 text-white-50"><%= dir.direccion %></p>
                                                        <% if (dir.referencia) { %>
                                                            <small class="text-muted">Ref: <%= dir.referencia %></small>
                                                        <% } %>
                                                    </div>
                                                    <div>
                                                        <a href="/intranet/direcciones/eliminar/<%= dir.id_direccion %>" 
                                                           class="btn btn-sm btn-outline-danger"
                                                           onclick="return confirm('¿Eliminar esta dirección?')">
                                                            <i class="bi bi-trash"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <p class="text-white-50">No tienes direcciones registradas.</p>
                                    <% } %>

                                    <button type="button" class="btn btn-outline-primary mt-2" data-bs-toggle="modal" data-bs-target="#modalNuevaDireccion">
                                        <i class="bi bi-plus-lg"></i> Agregar Nueva Dirección
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>



    <div class="modal fade" id="modalNuevaDireccion" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title futuristic-title">Nueva Dirección</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/intranet/direcciones/agregar" method="POST">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Ciudad / Distrito</label>
                            <input type="text" class="form-control" name="ciudad" placeholder="Ej: Lima, Miraflores" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Dirección Exacta</label>
                            <input type="text" class="form-control" name="direccion" placeholder="Av. Principal 123, Dpto 401" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Referencia (Opcional)</label>
                            <input type="text" class="form-control" name="referencia" placeholder="Frente al parque...">
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="es_predeterminada" id="checkPred">
                            <label class="form-check-label" for="checkPred">Marcar como predeterminada</label>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>





    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/app_sidebar_bootstrap.js"></script>

</body>
</html>