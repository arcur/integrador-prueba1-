<%- include('partials/header') %>

<h1>
    <i class="bi bi-headset"></i> Contáctanos
</h1>
<hr style="border-color: rgba(106, 13, 173, 0.5); margin-bottom: 30px;">

<div class="contacto-layout">
    <div class="row g-4"> 
        
        <div class="col-lg-6">
            <div class="card-theme h-100 p-4 d-flex flex-column justify-content-center text-center"> 
                
                <h2 class="mb-4">Información de Contacto</h2> 
                
                <div class="mb-3"> 
                    <h5><i class="bi bi-envelope-fill me-2" style="color: #d6b5ff;"></i> Correo Electrónico</h5>
                    <p class="mb-0 text-white-50">soporte@techstore.com.pe</p>
                </div>

                <div class="mb-3"> 
                    <h5><i class="bi bi-telephone-fill me-2" style="color: #d6b5ff;"></i> Teléfono</h5>
                    <p class="mb-0 text-white-50">+51 999 888 777 (Lun-Vie: 9am - 6pm)</p>
                </div>

                <div class="mb-4"> 
                    <h5><i class="bi bi-geo-alt-fill me-2" style="color: #d6b5ff;"></i> Dirección de Oficina</h5>
                    <p class="mb-0 text-white-50">Av. De la Innovación Nro. 101, Lima, Perú</p>
                </div>

                <div> 
                    <h5 class="mb-3">Redes Sociales</h5>
                    <div class="social-icons">
                        <a href="#" target="_blank" title="Facebook"><i class="bi bi-facebook fs-3"></i></a>
                        <a href="#" target="_blank" title="Instagram"><i class="bi bi-instagram fs-3"></i></a>
                        <a href="#" target="_blank" title="Twitter"><i class="bi bi-twitter-x fs-3"></i></a>
                    </div>
                </div>
                 
            </div>
        </div>
        
        <div class="col-lg-6">
            <div class="card-theme p-4 h-100 text-center d-flex flex-column justify-content-center align-items-center">
                <h2>¿Necesitas Ayuda Rápida?</h2>
                <p class="lead" style="color: #ccc; margin-bottom: 30px;"> 
                    ¡Contáctanos a nuestro <strong>Chatbot de WhatsApp</strong> para obtener soporte inmediato! 
                </p>

                <a href="#" target="_blank" class="text-decoration-none" title="Abrir Chatbot de WhatsApp">
                    <i class="bi bi-whatsapp whatsapp-icon"></i>
                </a>
                
                <p class="mt-3 fs-5" style="color: #4dff94;">
                    <i class="bi bi-robot me-2"></i> Iniciar Chat
                </p>
            </div>
        </div>
        
    </div>
</div>

<style>
/* Estilo específico para Contáctanos */
.contacto-layout .social-icons a {
    font-size: 2rem !important; 
    margin-right: 15px; 
    margin-left: 15px; 
}
.whatsapp-icon {
    font-size: 6rem;
    color: #25D366; 
    transition: transform 0.3s;
}
.whatsapp-icon:hover {
    transform: scale(1.1); 
    color: #38c86d; 
}
/* Estilos para los h5 de contacto */
.contacto-layout h5 {
     color: #d6b5ff; 
     margin-top: 0.5rem; 
     margin-bottom: 0.25rem; 
}
</style>

<%- include('partials/footer') %>