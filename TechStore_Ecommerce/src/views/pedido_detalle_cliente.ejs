<%- include('partials/header') %>

<% if (locals.error_msg && error_msg.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show flash-alert" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error_msg %>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<h1><i class="bi bi-receipt"></i> Detalle del Pedido</h1>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/mi-cuenta">Mi Cuenta</a></li>
    <li class="breadcrumb-item"><a href="/mis-pedidos">Mis Pedidos</a></li>
    <li class="breadcrumb-item active" aria-current="page">Pedido #<%= pedido.id_pedido %></li>
  </ol>
</nav>
<hr style="border-color: rgba(106, 13, 173, 0.5); margin-bottom: 30px;">

<div class="card-theme p-4">

    <div class="pedido-detalle-header row g-3 mb-4">
        <div class="col-md-4"> <strong>Pedido #:</strong> <span class="text-white">#<%= pedido.id_pedido %></span> </div>
        <div class="col-md-4"> <strong>Fecha:</strong> <span class="text-white"><%= new Date(pedido.fecha).toLocaleDateString('es-PE', { day: '2-digit', month: 'long', year: 'numeric'}) %></span> </div>
        <div class="col-md-4"> <strong>Estado:</strong>
            <% if (pedido.estado === 'Pendiente') { %> <span class="badge text-bg-warning"><%= pedido.estado %></span>
            <% } else if (pedido.estado === 'Pagado') { %> <span class="badge text-bg-success"><%= pedido.estado %></span>
            <% } else if (pedido.estado === 'Enviado') { %> <span class="badge text-bg-info"><%= pedido.estado %></span>
            <% } else { %> <span class="badge text-bg-danger"><%= pedido.estado %></span> <% } %>
        </div>
    </div>
     <hr style="border-color: rgba(255, 255, 255, 0.2); margin: 1.5rem 0;">

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <h5><i class="bi bi-person-lines-fill"></i> Datos del Cliente</h5>
            <p class="mb-1"><%= pedido.nombre %> <%= pedido.apellido_paterno %></p>
            <p class="mb-1"><%= pedido.correo %></p>
            <p class="mb-0"><%= pedido.telefono || 'Teléfono no registrado' %></p>
        </div>
        <div class="col-md-6">
            <h5><i class="bi bi-geo-alt-fill"></i> Dirección de Envío</h5>
            <% if (pedido.direccion_envio) { %>
                <p class="text-white"><%= pedido.direccion_envio %></p> <% } else { %>
                <p class="text-muted">(No especificada)</p>
            <% } %>

             <h5 class="mt-3"><i class="bi bi-credit-card"></i> Método de Pago</h5>
             <% if (pedido.metodo_pago) { %>
                 <p class="text-white fw-bold"><%= pedido.metodo_pago %></p> <% } else { %>
                 <p class="text-muted">(Pago no registrado)</p>
             <% } %>
              <h5><i class="bi bi-receipt"></i> Comprobante</h5>
              <p class="text-white"><%= pedido.tipo_comprobante %></p> </div>
    </div>

     <hr style="border-color: rgba(255, 255, 255, 0.2); margin: 1.5rem 0;">

    <h5><i class="bi bi-box-seam"></i> Productos Comprados</h5>
    <div class="table-responsive mt-3">
        <table class="table table-pedidos-cliente align-middle">
            <thead> </thead>
            <tbody> </tbody>
            <tfoot> </tfoot>
             <thead> <tr> <th scope="col" style="width: 60%;">Producto</th> <th scope="col" class="text-end">Precio Unit.</th> <th scope="col" class="text-center">Cantidad</th> <th scope="col" class="text-end">Subtotal</th> </tr> </thead>
             <tbody> <% detalles.forEach(item => { %> <tr> <td> <div class="d-flex align-items-center gap-3"> <img src="<%= item.imagen ? item.imagen : '/img/placeholder-prod.webp' %>" alt="<%= item.nombre_producto %>" class="carrito-item-img" onerror="this.onerror=null; this.src='/img/placeholder-prod.webp';"> <a href="/producto/<%= item.id_producto %>" class="carrito-item-nombre"> <%= item.nombre_producto %> </a> </div> </td> <td class="text-end">S/ <%= item.precio_unitario.toFixed(2) %></td> <td class="text-center"><%= item.cantidad %></td> <td class="text-end fw-bold">S/ <%= (item.precio_unitario * item.cantidad).toFixed(2) %></td> </tr> <% }) %> </tbody>
             <tfoot> <tr> <td colspan="3" class="text-end border-0 pt-3"><strong>Total Pedido:</strong></td> <td class="text-end border-0 pt-3 fs-5 fw-bold" style="color: #4dff94;">S/ <%= pedido.total.toFixed(2) %></td> </tr> </tfoot>
        </table>
    </div>

    <div class="text-center mt-4">
        <a href="/mis-pedidos" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left-circle"></i> Volver a Mis Pedidos
        </a>
    </div>

</div>

<%- include('partials/footer') %>