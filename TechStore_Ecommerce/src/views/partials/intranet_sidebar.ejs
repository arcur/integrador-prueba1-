<div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark vh-100 sticky-top" style="width: 280px;">
    
    <a href="intranet_dashboard." class="d-flex align-items-center mb-3 mb-md-0 w-100 text-white text-decoration-none">
        <img src="/img/techstore-Photoroom.png" alt="TechStore Logo" style="width: 80%; max-width: 150px; height: auto;" class="mx-auto">
    </a>

    <hr>

    <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item">
            <a href="/intranet/dashboard" class="nav-link text-white <%= (locals.currentPage === 'dashboard') ? 'active' : '' %>">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
        </li>
        <li class="nav-item">
            <a href="/intranet/mis_pedidos" class="nav-link text-white <%= (locals.currentPage === 'pedidos') ? 'active' : '' %>">
                <i class="bi bi-box-seam me-2"></i> Mis Pedidos
            </a>
        </li>
        <li class="nav-item">
            <a href="/intranet/mis_favoritos" class="nav-link text-white <%= (locals.currentPage === 'favoritos') ? 'active' : '' %>">
                <i class="bi bi-heart me-2"></i> Mis Favoritos
            </a>
        </li>
        <li class="nav-item">
            <a href="/intranet/mis_tarjetas" class="nav-link text-white <%= (locals.currentPage === 'tarjetas') ? 'active' : '' %>">
                <i class="bi bi-credit-card me-2"></i> Mis Tarjetas
            </a>
        </li>
        <li class="nav-item">
            <a href="/intranet/configuracion" class="nav-link text-white <%= (locals.currentPage === 'configuracion') ? 'active' : '' %>">
                <i class="bi bi-gear me-2"></i> Configuración
            </a>
        </li>
    </ul>

    <ul class="nav nav-pills flex-column">
        <li class="nav-item">
            <a href="/intranet/configuracion" class="nav-link nav-link-danger">
                <i class="bi bi-trash me-2"></i> Eliminar Cuenta
            </a>
        </li>
    </ul>

    <hr>
    
    <div class="dropdown">
        <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-avatar-sm me-2"><%= datosUsuario.nombre.substring(0, 2).toUpperCase() %></div>
            <strong><%= datosUsuario.nombre %></strong>
        </a>
        <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
            <li><a class="dropdown-item" href="/logout">Cerrar Sesión</a></li>
        </ul>
    </div>
</div>