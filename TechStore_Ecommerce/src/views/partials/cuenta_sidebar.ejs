<%# src/views/partials/cuenta_sidebar.ejs %>
<div class="d-flex flex-column flex-shrink-0 p-3 sidebar-cuenta vh-100 sticky-top" style="width: 280px;"> <%# Aplicar clase y estilos %>

    <a href="/" class="d-flex align-items-center mb-3 mb-md-0 w-100 text-decoration-none justify-content-center">
        <%# Logo Principal %>
        <img src="/img/techstore.jpg" alt="TechStore Logo" style="width: 70%; max-width: 120px; height: auto;">
    </a>
    <hr>
    <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item">
            <a href="/cuenta" class="nav-link <%= (currentPage === 'dashboard') ? 'active' : '' %>">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
        </li>
        <li class="nav-item">
            <a href="/cuenta/pedidos" class="nav-link <%= (currentPage === 'pedidos') ? 'active' : '' %>">
                <i class="bi bi-box-seam me-2"></i> Mis Pedidos
            </a>
        </li>
        <li class="nav-item">
            <a href="/cuenta/favoritos" class="nav-link <%= (currentPage === 'favoritos') ? 'active' : '' %>">
                <i class="bi bi-heart me-2"></i> Mis Favoritos
            </a>
        </li>
        <li class="nav-item">
            <a href="/cuenta/tarjetas" class="nav-link <%= (currentPage === 'tarjetas') ? 'active' : '' %>">
                <i class="bi bi-credit-card me-2"></i> Mis Tarjetas
            </a>
        </li>
        <li class="nav-item">
            <a href="/cuenta/configuracion" class="nav-link <%= (currentPage === 'configuracion') ? 'active' : '' %>">
                <i class="bi bi-gear me-2"></i> Configuración
            </a>
        </li>
    </ul>
    <hr>
    <div class="dropdown">
        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-avatar-sm me-2">
                <%= user.nombre ? user.nombre.charAt(0).toUpperCase() : 'U' %>
            </div>
            <strong><%= user.nombre || 'Usuario' %></strong>
        </a>
        <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
            <li><a class="dropdown-item" href="/cuenta/configuracion">Configuración</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/logout">Cerrar Sesión</a></li>
        </ul>
    </div>
</div>

