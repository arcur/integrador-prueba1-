<%- include('partials/header') %>

<link rel="stylesheet" href="/css/success.css">

<div class="success-wrapper">
    <div class="success-card">
        
        <div class="icon-container">
            <i class="bi bi-check-lg check-icon"></i>
        </div>

        <h1>¡Pago Exitoso!</h1>
        <p class="text-white-50 fs-5 mb-0">Tu pedido ha sido confirmado.</p>

        <div class="order-box">
            <div class="row align-items-center">
                <div class="col-6 border-end border-secondary">
                    <div class="order-label">Nro. Orden</div>
                    <div class="order-value">#<%= id_pedido %></div>
                </div>
                <div class="col-6 text-center">
                    <div class="order-label">Fecha</div>
                    <div class="text-white fw-bold"><%= new Date().toLocaleDateString('es-PE') %></div>
                </div>
            </div>
        </div>

        <p class="email-note">
            Hemos enviado un correo de confirmación a <span class="email-highlight"><%= user.correo %></span> con tu boleta/factura adjunta y los detalles de envío.
        </p>

        <div class="btn-group-vertical w-100">
            <a href="/intranet/mis_pedidos" class="btn-primary-glow">
                <i class="bi bi-box-seam me-2"></i> Ver Estado de mi Pedido
            </a>
            
            <a href="/catalogo" class="btn-secondary-outline">
                <i class="bi bi-arrow-left me-2"></i> Seguir Comprando
            </a>
        </div>

    </div>
</div>

<%- include('partials/footer') %>