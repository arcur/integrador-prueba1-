    </p>
    <div class="d-grid gap-3 d-sm-flex justify-content-sm-center mt-5"> <a href="/catalogo" class="btn-theme btn-lg px-4"> <i class="bi bi-shop"></i> Seguir Comprando
        </a>
        <a href="#" class="btn btn-outline-light btn-lg px-4"> <i class="bi bi-person-lines-fill"></i> Ver mis Pedidos
        </a>
    </div>
</div>

<%- include('partials/footer') %>