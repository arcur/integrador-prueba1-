<%- include('partials/header') %>

<h1>
    <i class="bi bi-shield-check-fill"></i> Confirmar Pedido
</h1>
<hr style="border-color: rgba(106, 13, 173, 0.5); margin-bottom: 30px;">

<div class="checkout-layout">

    <section class="checkout-resumen card-theme">
        <h4>Resumen de tu Carrito</h4>
        <ul class="list-group list-group-flush resumen-lista mt-3">

            <% carrito.items.forEach(item => { %>
                <li class="list-group-item d-flex justify-content-between lh-sm">
                    <div>
                        <h6 class="my-0"><%= item.nombre_producto %></h6>
                        <small class="text-muted">Cantidad: <%= item.cantidad %></small>
                    </div>
                    <span class="text-muted">S/ <%= (item.precio * item.cantidad).toFixed(2) %></span>
                </li>
            <% }) %>

            <li class="list-group-item d-flex justify-content-between total-row">
                <strong class="fs-5">Total</strong>
                <strong class="fs-5">S/ <%= carrito.total.toFixed(2) %></strong>
            </li>
        </ul>
        <a href="/carrito" class="btn btn-sm btn-outline-secondary mt-3">
            <i class="bi bi-pencil-fill"></i> Modificar Carrito
        </a>
    </section>

    <section class="checkout-datos card-theme">
        <h4>Datos de Entrega y Pago</h4>

        <div class="datos-cliente mb-4">
            <h5><i class="bi bi-person-fill"></i> Cliente</h5>
            <p class="mb-1"><strong>Nombre:</strong> <%= user.nombre %></p>
            <% if (locals.userData) { %> <p class="mb-1"><strong>Correo:</strong> <%= userData.correo %></p>
                 <p class="mb-1"><strong>DNI:</strong> <%= userData.numero_dni %></p>
            <% } %>
        </div>
         <hr style="border-color: rgba(255, 255, 255, 0.2);">

        <div class="direccion-envio my-4">
            <h5><i class="bi bi-truck"></i> Dirección de Envío</h5>
            <p class="text-muted small mb-2">(Función de dirección de envío aún no implementada)</p>
            <input type="text" class="form-control input-theme" placeholder="Ej: Av. La Molina 123, Lima" disabled>
             </div>
         <hr style="border-color: rgba(255, 255, 255, 0.2);">

        <div class="metodo-pago my-4">
            <h5><i class="bi bi-credit-card-fill"></i> Método de Pago</h5>
            <p class="text-muted small mb-2">(Selección de pago aún no implementada)</p>
            <select class="form-select select-theme" disabled>
                <option>Pago contra entrega (Temporal)</option>
                </select>
             </div>

        <form action="/pedido/procesar" method="POST" class="d-grid"> <button type="submit" class="btn-theme btn-lg">
                <i class="bi bi-bag-check-fill"></i>
                Confirmar y Finalizar Pedido
            </button>
        </form>
    </section>
</div>

<%- include('partials/footer') %>