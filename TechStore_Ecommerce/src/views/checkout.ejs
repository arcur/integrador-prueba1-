<%- include('partials/header') %>
    <link rel="stylesheet" href="/css/checkout.css">

    <div class="checkout-wrapper py-5">
        <div class="container" style="max-width: 1200px;">

            <h2 class="text-white mb-4 fw-bold">Finalizar Compra</h2>

            <% if (locals.error) { %>
                <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4">
                    <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
                    <%= error %>
                </div>
                <% } %>

                    <form action="/pedido/procesar" method="POST" id="checkoutForm">
                        <div class="row g-5">

                            <div class="col-lg-8">

                                <div class="checkout-accordion-item active" id="step1">
                                    <div class="accordion-header" onclick="toggleSection('step1')">
                                        <div class="step-title">
                                            <span class="step-number">1</span> Dirección de Envío
                                        </div>
                                        <i class="bi bi-chevron-down accordion-icon"></i>
                                    </div>
                                    <div class="accordion-body">
                                        <div class="body-content">
                                            <% if (direcciones && direcciones.length> 0) { %>
                                                <div class="row g-3">
                                                    <% direcciones.forEach((dir, index)=> { %>
                                                        <div class="col-md-6">
                                                            <label class="selectable-card">
                                                                <input type="radio" name="id_direccion"
                                                                    value="<%= dir.id_direccion %>"
                                                                    <%=(dir.es_predeterminada || index===0) ? 'checked'
                                                                    : '' %>>
                                                                <div class="card-inner">
                                                                    <i class="bi bi-check-circle-fill check-mark"></i>
                                                                    <strong class="text-info d-block mb-1">
                                                                        <%= dir.ciudad %>
                                                                    </strong>
                                                                    <p class="small text-white-50 mb-0">
                                                                        <%= dir.direccion %>
                                                                    </p>
                                                                </div>
                                                            </label>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                                <div class="mt-3 text-end">
                                                    <a href="/intranet/configuracion"
                                                        class="text-decoration-none text-muted small hover-white">
                                                        <i class="bi bi-plus-lg"></i> Agregar nueva dirección
                                                    </a>
                                                </div>
                                                <div class="mt-4 border-top border-secondary pt-3">
                                                    <button type="button"
                                                        class="btn btn-primary btn-sm px-4 rounded-pill"
                                                        onclick="toggleSection('step2')">
                                                        Continuar a Pago <i class="bi bi-arrow-down"></i>
                                                    </button>
                                                </div>
                                                <% } else { %>
                                                    <div class="text-center py-3">
                                                        <p class="text-white-50">No tienes direcciones registradas.</p>
                                                        <a href="/intranet/configuracion"
                                                            class="btn btn-outline-light btn-sm">Agregar Dirección</a>
                                                    </div>
                                                    <% } %>
                                        </div>
                                    </div>
                                </div>

                                <div class="checkout-accordion-item" id="step2">
                                    <div class="accordion-header" onclick="toggleSection('step2')">
                                        <div class="step-title">
                                            <span class="step-number">2</span> Método de Pago
                                        </div>
                                        <i class="bi bi-chevron-down accordion-icon"></i>
                                    </div>
                                    <div class="accordion-body">
                                        <div class="body-content">
                                            <% if (tarjetas && tarjetas.length> 0) { %>
                                                <div class="d-flex flex-column gap-3">
                                                    <% tarjetas.forEach((card, index)=> { %>
                                                        <label class="selectable-card">
                                                            <input type="radio" name="id_tarjeta"
                                                                value="<%= card.id_tarjeta %>" <%=(index===0)
                                                                ? 'checked' : '' %>>
                                                            <div class="card-inner d-flex align-items-center">
                                                                <div class="me-3 fs-3 text-white-50"><i
                                                                        class="bi bi-credit-card-2-front"></i></div>
                                                                <div class="flex-grow-1">
                                                                    <div class="fw-bold text-white">
                                                                        <%= card.tipo_tarjeta %> **** <%=
                                                                                card.ultimos_cuatro_digitos %>
                                                                    </div>
                                                                    <div class="small text-muted">Vence: <%=
                                                                            card.fecha_expiracion %>
                                                                    </div>
                                                                </div>
                                                                <i
                                                                    class="bi bi-check-circle-fill check-mark position-relative top-0 right-0 me-3"></i>

                                                                <div
                                                                    class="cvv-reveal ms-3 ps-3 border-start border-secondary">
                                                                    <label
                                                                        class="small text-white-50 d-block">CVV</label>
                                                                    <input type="password"
                                                                        class="form-control form-control-sm input-dark text-center"
                                                                        style="width: 60px;" placeholder="123"
                                                                        maxlength="3"
                                                                        oninput="this.value = this.value.replace(/[^0-9]/g, ''); document.getElementById('cvv_real').value = this.value">
                                                                </div>
                                                            </div>
                                                        </label>
                                                        <% }) %>
                                                </div>
                                                <input type="hidden" name="cvv" id="cvv_real">
                                                <div class="mt-4 border-top border-secondary pt-3">
                                                    <button type="button"
                                                        class="btn btn-primary btn-sm px-4 rounded-pill"
                                                        onclick="toggleSection('step3')">
                                                        Continuar a Confirmación <i class="bi bi-arrow-down"></i>
                                                    </button>
                                                </div>
                                                <% } else { %>
                                                    <div class="text-center py-3">
                                                        <p class="text-white-50">No tienes tarjetas guardadas.</p>
                                                        <a href="/intranet/mis_tarjetas"
                                                            class="btn btn-outline-light btn-sm">Agregar Tarjeta</a>
                                                    </div>
                                                    <% } %>
                                        </div>
                                    </div>
                                </div>

                                <div class="checkout-accordion-item" id="step3">
                                    <div class="accordion-header" onclick="toggleSection('step3')">
                                        <div class="step-title">
                                            <span class="step-number">3</span> Datos de Facturación
                                        </div>
                                        <i class="bi bi-chevron-down accordion-icon"></i>
                                    </div>
                                    <div class="accordion-body">
                                        <div class="body-content">
                                            <div class="d-flex gap-3 mb-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="tipo_comprobante"
                                                        id="optBoleta" value="Boleta" checked
                                                        onchange="toggleFactura(false)">
                                                    <label class="form-check-label text-white"
                                                        for="optBoleta">Boleta</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="tipo_comprobante"
                                                        id="optFactura" value="Factura" onchange="toggleFactura(true)">
                                                    <label class="form-check-label text-white"
                                                        for="optFactura">Factura</label>
                                                </div>
                                            </div>

                                            <div id="infoBoleta" class="p-3 bg-white bg-opacity-10 rounded text-center">
                                                <small class="text-white-50">Boleta a nombre de:</small>
                                                <div class="fw-bold text-white">
                                                    <%= user.nombre %>
                                                </div>
                                            </div>

                                            <div id="infoFactura" style="display: none;">
                                                <div class="input-group mb-2">
                                                    <input type="text" class="form-control input-dark" id="inputRUC"
                                                        name="ruc" placeholder="RUC (11 dígitos)" maxlength="11">
                                                    <button class="btn btn-secondary" type="button"
                                                        id="btnValidarRUC"><i class="bi bi-search"></i></button>
                                                </div>
                                                <small id="apiMessage" class="d-block mb-2 text-warning"></small>
                                                <input type="text" class="form-control input-dark mb-2"
                                                    id="inputRazonSocial" name="razon_social" placeholder="Razón Social"
                                                    readonly>
                                                <input type="text" class="form-control input-dark"
                                                    id="inputDireccionFiscal" name="direccion_fiscal"
                                                    placeholder="Dirección Fiscal" readonly>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                         <div class="col-lg-4">
                <div class="summary-container">
                    
                    <div class="summary-header">
                        <h5><i class="bi bi-bag-check-fill me-2"></i> Resumen del Pedido</h5>
                    </div>

                    <div class="summary-products-list custom-scrollbar">
                        <% carrito.items.forEach(item => { %>
                            <div class="summary-item">
                                <div class="item-left">
                                    <div class="item-img-box">
                                        <img src="<%= item.imagen ? item.imagen : '/img/placeholder-prod.webp' %>" class="item-img" alt="">
                                        <span class="item-badge"><%= item.cantidad %></span>
                                    </div>
                                    <div class="item-info">
                                        <h6 title="<%= item.nombre_producto %>"><%= item.nombre_producto %></h6>
                                    </div>
                                </div>
                                <div class="item-price">
                                    S/ <%= (item.precio * item.cantidad).toFixed(2) %>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <div class="coupon-section mt-3">
                        <label class="text-white-50 small mb-2 d-block">¿Tienes un cupón?</label>
                        <div class="input-group input-group-coupon">
                            <input type="text" class="form-control text-uppercase" id="inputCupon" placeholder="CÓDIGO">
                            <button class="btn btn-outline-primary" type="button" id="btnAplicarCupon">Aplicar</button>
                        </div>
                        <small id="msgCupon" class="d-block mt-2" style="min-height: 20px;"></small>
                    </div>
                    
                    <input type="hidden" name="codigo_cupon" id="hiddenCupon" form="checkoutForm">

                    <div class="summary-footer">
                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span>S/ <%= carrito.total.toFixed(2) %></span>
                        </div>
                        
                        <div class="summary-row text-success fw-bold" id="rowDescuento" style="display: none !important;">
                            <span>Descuento <i class="bi bi-tag-fill"></i></span>
                            <span id="montoDescuento">- S/ 0.00</span>
                        </div>

                        <div class="summary-row">
                            <span>Envío</span>
                            <span class="text-success">Gratis</span>
                        </div>
                        
                        <div class="summary-row total">
                            <span>Total</span>
                            <span class="text-primary" id="totalPagar">S/ <%= carrito.total.toFixed(2) %></span>
                        </div>

                        <button type="submit" form="checkoutForm" class="btn-finish">
                            Finalizar Compra <i class="bi bi-arrow-right-short fs-4 align-middle"></i>
                        </button>
                        
                        <p class="text-center mt-3 mb-0" style="font-size: 0.75rem; color: #666;">
                            <i class="bi bi-shield-lock-fill"></i> Tus datos están protegidos por SSL.
                        </p>
                    </div>

                </div>
            </div>

                        </div>
                    </form>
        </div>
    </div>

    <script>
        // CONTROL DEL ACORDEÓN
        function toggleSection(id) {
            // Cerrar todos
            document.querySelectorAll('.checkout-accordion-item').forEach(el => {
                el.classList.remove('active');
            });
            // Abrir el seleccionado
            document.getElementById(id).classList.add('active');
        }

        // (LÓGICA RUC IGUAL QUE ANTES)
        function toggleFactura(show) {
            const f = document.getElementById('infoFactura');
            const b = document.getElementById('infoBoleta');
            f.style.display = show ? 'block' : 'none';
            b.style.display = show ? 'none' : 'block';
            document.getElementById('inputRUC').required = show;
        }

        document.getElementById('btnValidarRUC').addEventListener('click', async function () {
            const ruc = document.getElementById('inputRUC').value;
            const btn = this;
            const msg = document.getElementById('apiMessage');
            const inputRazon = document.getElementById('inputRazonSocial');
            const inputDireccion = document.getElementById('inputDireccionFiscal');

            // Resetear estado
            msg.textContent = '';
            inputRazon.value = '';
            inputDireccion.value = '';

            if (ruc.length !== 11) {
                msg.textContent = '⚠️ El RUC debe tener 11 dígitos exactos.';
                return;
            }

            // Estado de carga
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            try {
                // LLAMAMOS A NUESTRA PROPIA RUTA (BACKEND)
                const response = await fetch(`/pedido/api/ruc/${ruc}`);

                if (!response.ok) throw new Error('Error en la búsqueda');

                const data = await response.json();

                // Llenar campos con datos reales
                inputRazon.value = data.razonSocial; // La API v2 suele devolver 'razonSocial'
                inputDireccion.value = data.direccion;

                // Bloquear campos para que no se editen por error
                inputRazon.readOnly = true;
                inputDireccion.readOnly = true;

                // Feedback visual de éxito
                btn.innerHTML = '<i class="bi bi-check-lg"></i>';
                btn.classList.replace('btn-primary', 'btn-success');

            } catch (error) {
                console.error(error);
                // Si falla, permitir modo manual
                msg.innerHTML = '<i class="bi bi-pencil"></i> No se encontraron datos. <strong>Ingrésalos manualmente.</strong>';

                inputRazon.readOnly = false;
                inputDireccion.readOnly = false;
                inputRazon.focus();

                // Cambiar estilo para indicar que es editable
                inputRazon.classList.remove('bg-dark-subtle');
                inputRazon.classList.add('bg-dark', 'border-secondary');

                inputDireccion.classList.remove('bg-dark-subtle');
                inputDireccion.classList.add('bg-dark', 'border-secondary');

                btn.innerHTML = '<i class="bi bi-search"></i>';
                btn.classList.replace('btn-success', 'btn-primary');
            } finally {
                btn.disabled = false;
            }
        });





        document.getElementById('btnAplicarCupon').addEventListener('click', async function () {
            const codigo = document.getElementById('inputCupon').value.trim();
            const btn = this;
            const msg = document.getElementById('msgCupon');

            if (!codigo) return;

            btn.disabled = true;
            btn.innerHTML = '...';
            msg.textContent = '';
            msg.className = 'd-block mt-1'; // Reset clases

            try {
                const res = await fetch('/pedido/api/validar-cupon', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ codigo })
                });

                const data = await res.json();

                if (data.success) {
                    // Éxito
                    msg.textContent = data.mensaje;
                    msg.classList.add('text-success');

                    // Actualizar UI
                    document.getElementById('rowDescuento').style.setProperty('display', 'flex', 'important');
                    document.getElementById('montoDescuento').textContent = `- S/ ${data.descuento}`;
                    document.getElementById('totalPagar').textContent = `S/ ${data.nuevoTotal}`;

                    // Guardar para el submit
                    document.getElementById('hiddenCupon').value = codigo;

                    // Bloquear input
                    document.getElementById('inputCupon').readOnly = true;
                    btn.textContent = 'Aplicado';
                    btn.classList.replace('btn-outline-primary', 'btn-success');
                } else {
                    // Error (cupón no válido, expirado, etc)
                    msg.textContent = data.error;
                    msg.classList.add('text-danger');
                }

            } catch (error) {
                console.error(error);
                msg.textContent = 'Error al validar cupón.';
                msg.classList.add('text-danger');
            } finally {
                if (document.getElementById('inputCupon').readOnly === false) {
                    btn.disabled = false;
                    btn.innerHTML = 'Aplicar';
                }
            }
        });





    </script>

    <%- include('partials/footer') %>