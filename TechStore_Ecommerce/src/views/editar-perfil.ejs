<%- include('partials/header') %>

<h1><i class="bi bi-pencil-square"></i> Editar Mi Perfil</h1>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/mi-cuenta">Mi Cuenta</a></li>
    <li class="breadcrumb-item active" aria-current="page">Editar Perfil</li>
  </ol>
</nav>
<hr style="border-color: rgba(106, 13, 173, 0.5); margin-bottom: 30px;">

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-theme p-4">

             <% if (locals.errors && errors.length > 0) { %>
                <div class="alert alert-danger mb-4" role="alert">
                    <h6 class="alert-heading" style="margin-bottom: 5px;"><i class="bi bi-exclamation-triangle-fill"></i> Corrige los errores:</h6>
                    <ul>
                        <% errors.forEach(err => { %>
                            <li><%= err %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form action="/editar-perfil" method="POST" novalidate>
                 <div class="row g-3">
                     <div class="col-md-4">
                         <label for="nombre" class="form-label profile-edit-label">Nombre</label>
                         <input type="text" class="form-control input-theme" id="nombre" name="nombre" required
                                value="<%= locals.formData ? formData.nombre : '' %>">
                     </div>
                     <div class="col-md-4">
                         <label for="apellido_paterno" class="form-label profile-edit-label">Apellido Paterno</label>
                         <input type="text" class="form-control input-theme" id="apellido_paterno" name="apellido_paterno" required
                                value="<%= locals.formData ? formData.apellido_paterno : '' %>">
                     </div>
                     <div class="col-md-4">
                         <label for="apellido_materno" class="form-label profile-edit-label">Apellido Materno</label>
                         <input type="text" class="form-control input-theme" id="apellido_materno" name="apellido_materno" required
                                value="<%= locals.formData ? formData.apellido_materno : '' %>">
                     </div>

                     <div class="col-md-6">
                         <label for="numero_dni" class="form-label profile-edit-label">DNI</label>
                         <input type="text" class="form-control input-theme" id="numero_dni" name="numero_dni"
                                value="<%= locals.formData ? formData.numero_dni : 'No registrado' %>" readonly disabled>
                         <div class="form-text text-muted small">El DNI no se puede modificar.</div>
                     </div>
                     <div class="col-md-6">
                         <label for="telefono" class="form-label profile-edit-label">Teléfono</label>
                         <input type="tel" class="form-control input-theme" id="telefono" name="telefono"
                                value="<%= locals.formData ? formData.telefono : '' %>" pattern="[0-9+]*" maxlength="15">
                     </div>

                     <div class="col-md-6">
                         <label for="correo" class="form-label profile-edit-label">Correo Electrónico</label>
                         <input type="email" class="form-control input-theme" id="correo" name="correo" required
                                value="<%= locals.formData ? formData.correo : '' %>">
                     </div>
                     <div class="col-md-6">
                         <label for="usuario" class="form-label profile-edit-label">Nombre de Usuario</label>
                         <input type="text" class="form-control input-theme" id="usuario" name="usuario" required
                                value="<%= locals.formData ? formData.usuario : '' %>">
                     </div>
                 </div>

                 <hr style="border-color: rgba(255, 255, 255, 0.2); margin: 2rem 0;">

                 <div class="d-flex justify-content-end gap-2">
                     <a href="/mi-cuenta" class="btn btn-outline-secondary">Cancelar</a>
                     <button type="submit" class="btn btn-theme">
                         <i class="bi bi-save-fill"></i> Guardar Cambios
                     </button>
                 </div>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>