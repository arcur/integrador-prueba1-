<%# src/views/TechStore_Intranet_Usuario/cuenta_configuracion.ejs %>
<%# Reemplaza a configuracion_usuario.html y editar-perfil.ejs %>

<%# --- Definir layout y página actual --- %>
<% layout('../layouts/cuenta_layout') -%>
<% locals.currentPage = 'configuracion' %>

<%# --- Contenido específico --- %>
<h2 class="futuristic-title mb-4">Configuración de Cuenta ⚙️</h2>

<div class="row">
    <%# Columna Datos Personales %>
    <div class="col-lg-6 mb-4">
        <div class="card card-theme h-100"> <%# Aplicar card-theme %>
            <div class="card-body">
                <h5 class="card-title mb-3">Datos Personales</h5>
                <form action="/cuenta/configuracion/perfil" method="POST" novalidate>
                    <div class="mb-3">
                        <label for="nombre" class="form-label profile-edit-label">Nombre</label>
                        <input type="text" class="form-control input-theme" id="nombre" name="nombre" value="<%= formData.nombre %>" required pattern="[A-Za-z\sñáéíóúÁÉÍÓÚ]+" title="Solo letras y espacios">
                    </div>
                     <div class="mb-3">
                        <label for="apellido_paterno" class="form-label profile-edit-label">Apellido Paterno</label>
                        <input type="text" class="form-control input-theme" id="apellido_paterno" name="apellido_paterno" value="<%= formData.apellido_paterno %>" required pattern="[A-Za-z\sñáéíóúÁÉÍÓÚ]+" title="Solo letras y espacios">
                    </div>
                     <div class="mb-3">
                        <label for="apellido_materno" class="form-label profile-edit-label">Apellido Materno</label>
                        <input type="text" class="form-control input-theme" id="apellido_materno" name="apellido_materno" value="<%= formData.apellido_materno %>" required pattern="[A-Za-z\sñáéíóúÁÉÍÓÚ]+" title="Solo letras y espacios">
                    </div>
                    <div class="mb-3">
                        <label for="correo" class="form-label profile-edit-label">Correo Electrónico</label>
                        <input type="email" class="form-control input-theme" id="correo" name="correo" value="<%= formData.correo %>" required>
                    </div>
                     <div class="mb-3">
                        <label for="usuario" class="form-label profile-edit-label">Nombre de Usuario</label>
                        <input type="text" class="form-control input-theme" id="usuario" name="usuario" value="<%= formData.usuario %>" required minlength="3">
                    </div>
                    <div class="mb-3">
                        <label for="telefono" class="form-label profile-edit-label">Número de Teléfono</label>
                        <input type="tel" class="form-control input-theme" id="telefono" name="telefono" value="<%= formData.telefono || '' %>" pattern="[0-9+]*" title="Solo números y +" maxlength="15">
                    </div>
                     <div class="mb-3">
                        <label for="numero_dni" class="form-label profile-edit-label">DNI</label>
                        <input type="text" class="form-control input-theme" id="numero_dni" name="numero_dni" value="<%= formData.numero_dni || '' %>" readonly disabled>
                        <div class="form-text text-muted small">El DNI no se puede modificar.</div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-2 btn-theme">Guardar Cambios de Perfil</button>
                </form>
            </div>
        </div>
    </div>

    <%# Columna Seguridad (Cambio Contraseña) %>
    <div class="col-lg-6 mb-4">
        <div class="card card-theme h-100"> <%# Aplicar card-theme %>
            <div class="card-body">
                <h5 class="card-title mb-3">Seguridad</h5>
                <form action="/cuenta/configuracion/password" method="POST" novalidate>
                    <div class="mb-3">
                        <label for="passCurrent" class="form-label profile-edit-label">Contraseña Actual</label>
                        <input type="password" class="form-control input-theme" id="passCurrent" name="passCurrent" placeholder="Ingresa tu contraseña actual" required>
                    </div>
                    <div class="mb-3">
                        <label for="passNew" class="form-label profile-edit-label">Nueva Contraseña</label>
                        <input type="password" class="form-control input-theme" id="passNew" name="passNew" placeholder="Mínimo 6 caracteres" required minlength="6">
                    </div>
                    <div class="mb-3">
                        <label for="passConfirm" class="form-label profile-edit-label">Confirmar Nueva Contraseña</label>
                        <input type="password" class="form-control input-theme" id="passConfirm" name="passConfirm" placeholder="Repite la nueva contraseña" required>
                    </div>
                    <button type="submit" class="btn btn-primary mt-2 btn-theme">Cambiar Contraseña</button>
                </form>
            </div>
        </div>
    </div>

    <%# Columna Direcciones (Placeholder) %>
    <div class="col-12 mb-4">
        <div class="card card-theme"> <%# Aplicar card-theme %>
            <div class="card-body">
                <h5 class="card-title mb-3">Direcciones de Envío (Próximamente)</h5>
                <div class="p-3 rounded border-start border-primary border-4 mb-3" style="background-color: rgba(255,255,255,0.05);">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div class="mb-2 mb-md-0">
                            <h6 class="mb-0">Dirección Principal</h6>
                            <p class="mb-0 text-body-secondary">Av. La Tecnología 404, Urb. Cyber, Lima, Perú</p>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-outline-secondary disabled">Editar</button>
                            <button class="btn btn-sm btn-outline-danger ms-2 disabled">Eliminar</button>
                        </div>
                    </div>
                </div>
                <button class="btn btn-outline-primary mt-2 disabled btn-theme"> <%# Usar btn-theme? %>
                    <i class="bi bi-plus-lg"></i> Agregar Nueva Dirección
                </button>
            </div>
        </div>
    </div>
</div>

