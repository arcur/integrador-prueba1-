<%# src/views/TechStore_Intranet_Usuario/cuenta_dashboard.ejs %>
<%# Reemplaza a intranet_usu.html y al antiguo mi-cuenta.ejs %>

<%# --- Definir layout y página actual --- %>
<% layout('../layouts/cuenta_layout') -%>
<% locals.currentPage = 'dashboard' %>

<%# --- Contenido específico de esta página --- %>
<h2 class="futuristic-title mb-4">Dashboard del Usuario</h2>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card card-theme h-100"> <%# Usar card-theme %>
            <div class="card-body">
                <h5 class="card-title">Información Rápida</h5>
                <p class="card-text">¡Bienvenido de nuevo a TechStore, <%= user.nombre %>!</p>

                <% if (ultimoPedido) { %>
                    <div class="d-flex justify-content-between align-items-end mt-3">
                        <div>
                            <h6>Último Pedido</h6>
                            <p class="mb-0">
                                <a href="/cuenta/pedidos/<%= ultimoPedido.id_pedido %>" class="link-primary text-decoration-none">
                                    #<%= ultimoPedido.id_pedido %>
                                </a>
                                <span class="ms-2">
                                    <% if (ultimoPedido.estado === 'Pendiente') { %> <span class="badge text-bg-warning"><%= ultimoPedido.estado %></span>
                                    <% } else if (ultimoPedido.estado === 'Pagado') { %> <span class="badge text-bg-success"><%= ultimoPedido.estado %></span>
                                    <% } else if (ultimoPedido.estado === 'Enviado') { %> <span class="badge text-bg-info"><%= ultimoPedido.estado %></span>
                                    <% } else { %> <span class="badge text-bg-danger"><%= ultimoPedido.estado %></span> <% } %>
                                </span>
                            </p>
                        </div>
                        <a href="/cuenta/pedidos" class="btn btn-primary btn-theme">Ver Todos</a>
                    </div>
                <% } else { %>
                    <p class="mt-3">Aún no has realizado pedidos.</p>
                     <a href="/catalogo" class="btn btn-primary btn-theme mt-2">Explorar Catálogo</a>
                <% } %>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card card-theme h-100"> <%# Usar card-theme %>
            <div class="card-body">
                <h5 class="card-title">Actividad de Compras</h5>
                <% if (statsCompras) { %>
                <ul class="list-group list-group-flush mt-3">
                    <li class="list-group-item bg-transparent text-light border-secondary">Total de Pedidos: <span class="fw-bold"><%= statsCompras.totalPedidos %></span></li>
                    <li class="list-group-item bg-transparent text-light border-secondary"><span class="fw-bold">Valor Total (Pagado/Enviado):</span> <strong style="color: #4dff94;">S/ <%= statsCompras.valorTotal.toFixed(2) %></strong></li>
                </ul>
                <% } else { %>
                     <p class="mt-3">No hay estadísticas de compras disponibles.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>
<%# Aquí puedes añadir más filas/columnas para Favoritos, Tarjetas, Alertas, etc. si lo necesitas %>

