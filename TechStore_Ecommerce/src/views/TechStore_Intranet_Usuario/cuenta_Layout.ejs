<!DOCTYPE html>
<html lang="es" data-bs-theme="light"> <%# Inicia en modo claro por defecto %>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - TechStore</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <%# Enlazamos el CSS base y el específico de la cuenta %>
    <link rel="stylesheet" href="/css/theme.css"> <%# Estilos generales del tema %>
    <link rel="stylesheet" href="/css/cuenta.css"> <%# Estilos específicos del sidebar y cuenta %>

    <%# Si la página específica necesita CSS adicional (ej: mis_pedidos) %>
    <% if (locals.pageStylesheets) { %>
        <% pageStylesheets.forEach(sheet => { %>
            <link rel="stylesheet" href="<%= sheet %>">
        <% }) %>
    <% } %>
</head>
<body>

    <div class="container-fluid">
        <div class="row">
            <%# Columna del Sidebar %>
            <div class="col-auto px-0">
                <%- include('../partials/cuenta_sidebar', { currentPage: currentPage, user: user }) %>
            </div>

            <%# Columna Principal del Contenido %>
            <div class="col py-3 cuenta-content-col">
                <header class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom cuenta-header">
                    <%# Título dinámico de la página %>
                    <h1 class="fs-4 mb-0 futuristic-title" id="cuenta-page-title"><%= title %></h1>
                    <%# Botón de Tema (controlado por cuenta.js) %>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="theme-toggle">
                        <label class="form-check-label" for="theme-toggle" id="theme-label">🌙 Modo Oscuro</label>
                    </div>
                </header>

                <main>
                    <%# Mensajes Flash (Error/Éxito) %>
                    <% if (locals.error_msg && error_msg.length > 0) { %>
                        <div class="alert alert-danger alert-dismissible fade show flash-alert" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i> <%= error_msg %>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>
                    <% if (locals.success_msg && success_msg.length > 0) { %>
                        <div class="alert alert-success alert-dismissible fade show flash-alert" role="alert">
                            <i class="bi bi-check-circle-fill"></i> <%= success_msg %>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>
                     <%# Mensaje específico para errores de validación %>
                     <% if (locals.validation_errors && validation_errors.length > 0) { %>
                        <div class="alert alert-danger alert-dismissible fade show flash-alert" role="alert">
                             <h6 class="alert-heading" style="margin-bottom: 5px;"><i class="bi bi-exclamation-triangle-fill"></i> Corrige los errores:</h6>
                             <ul>
                                <% validation_errors.forEach(err => { %>
                                    <li><%= err %></li>
                                <% }) %>
                            </ul>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>


                    <%# Aquí se insertará el contenido específico de cada página %>
                    <%- body %>
                </main>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <%# Enlazamos el JS específico de la cuenta %>
    <script src="/js/cuenta.js"></script>

    <%# Si la página específica necesita JS adicional %>
     <% if (locals.pageScripts) { %>
        <% pageScripts.forEach(script => { %>
            <script src="<%= script %>"></script>
        <% }) %>
    <% } %>
</body>
</html>

