<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechStore - Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" type="/image/png" href="/img/techstore-Photoroom.png">
    <link rel="stylesheet" href="/css/style_base.css">
</head>

<body>

    <div class="container-fluid">
        <div class="row">
            <div class="col-auto px-0">
                <%- include('partials/intranet_sidebar') %>
            </div>

            <div class="col py-3">
                <header class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                    <h1 class="futuristic-title fs-4"> </h1>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="theme-toggle">
                        <label class="form-check-label" for="theme-toggle">☀️ Modo Claro</label>
                    </div>
                </header>

                <main>
                    <h2 class="futuristic-title mb-4">Dashboard del Usuario</h2>

                    <div class="row">
                        <%# --- CARD 1: INFORMACIÓN RÁPIDA (Último Pedido) --- %>
                            <div class="col-lg-6 mb-4">
                                <div class="card bg-secondary text-light border-0 h-100">
                                    <div class="card-body">
                                        <h5 class="card-title">Información Rápida</h5>
                                        <p class="card-text">¡Gracias por ser parte de la comunidad TechStore!</p>

                                        <div class="d-flex justify-content-between align-items-end mt-3">
                                            <div>
                                                <h6>Último Pedido</h6>
                                                <% if (resumen.ultimoPedido) { %>
                                                    <p class="text-info-emphasis mb-0 fw-bold">
                                                        #<%= resumen.ultimoPedido.id_pedido %>
                                                            <span
                                                                class="badge bg-dark text-white border border-secondary ms-1">
                                                                <%= resumen.ultimoPedido.estado %>
                                                            </span>
                                                    </p>
                                                    <small class="text-white-50">
                                                        <%= new
                                                            Date(resumen.ultimoPedido.fecha).toLocaleDateString('es-PE')
                                                            %>
                                                    </small>
                                                    <% } else { %>
                                                        <p class="text-white-50 mb-0">Aún no has realizado pedidos.</p>
                                                        <% } %>
                                            </div>
                                            <%# ENLACE ARREGLADO %>
                                                <a href="/intranet/mis_pedidos" class="btn btn-primary">Ver Pedidos</a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <%# --- CARD 2: ACTIVIDAD DE COMPRAS (Totales) --- %>
                                <div class="col-lg-6 mb-4">
                                    <div class="card bg-secondary text-light border-0 h-100">
                                        <div class="card-body">
                                            <h5 class="card-title">Actividad de Compras</h5>
                                            <ul class="list-group list-group-flush mt-3">
                                                <li class="list-group-item bg-transparent text-light border-secondary">
                                                    Total de Pedidos: <span class="fw-bold">
                                                        <%= resumen.totalPedidos %>
                                                    </span>
                                                </li>
                                                <li class="list-group-item bg-transparent text-light border-secondary">
                                                    <span class="fw-bold">Valor Total Comprado:</span>
                                                    <strong style="color: #4dff94;">S/ <%=
                                                            resumen.totalGastado.toFixed(2) %></strong>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                    </div>

                    <div class="row">
                        <%# --- CARD 3: FAVORITOS RECIENTES --- %>
                            <div class="col-lg-6 mb-4">
                                <div class="card bg-secondary text-light border-0 h-100">
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title">Mis Favoritos Recientes</h5>

                                        <ul class="list-group list-group-flush mt-3 flex-grow-1">
                                            <% if (resumen.favoritosRecientes.length> 0) { %>
                                                <% resumen.favoritosRecientes.forEach(fav=> { %>
                                                    <li
                                                        class="list-group-item bg-transparent text-light border-secondary px-0 py-3">
                                                        <div class="d-flex align-items-center justify-content-between">

                                                            <div class="d-flex align-items-center"
                                                                style="overflow: hidden;">
                                                                <a href="/producto/<%= fav.id_producto %>">
                                                                    <img src="<%= fav.imagen ? fav.imagen : '/img/placeholder-prod.webp' %>"
                                                                        alt=""
                                                                        style="width: 50px; height: 50px; object-fit: contain; margin-right: 15px; background: rgba(255,255,255,0.05); border-radius: 6px;">
                                                                </a>
                                                                <div class="text-truncate">
                                                                    <a href="/producto/<%= fav.id_producto %>"
                                                                        class="text-decoration-none text-light fw-bold d-block text-truncate"
                                                                        style="max-width: 180px;">
                                                                        <%= fav.nombre_producto %>
                                                                    </a>
                                                                    <small class="text-success">S/ <%=
                                                                            fav.precio.toFixed(2) %></small>
                                                                </div>
                                                            </div>

                                                            <button type="button"
                                                                class="btn btn-sm btn-theme btn-add-to-cart ms-2"
                                                                style="min-width: 40px; padding: 0.25rem 0.5rem;"
                                                                title="Añadir al carrito"
                                                                data-product-id="<%= fav.id_producto %>"
                                                                data-product-name="<%= fav.nombre_producto %>">
                                                                <i class="bi bi-cart-plus"></i>
                                                            </button>

                                                        </div>
                                                    </li>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <li
                                                                class="list-group-item bg-transparent text-white-50 border-secondary px-0 text-center py-4">
                                                                <i class="bi bi-heart fs-1 d-block mb-2 opacity-50"></i>
                                                                No tienes favoritos guardados.
                                                            </li>
                                                            <% } %>
                                        </ul>

                                        <a href="/intranet/mis_favoritos"
                                            class="btn btn-sm btn-outline-light mt-3 align-self-start">Ver todos mis
                                            favoritos</a>
                                    </div>
                                </div>
                            </div>

                            <%# --- CARD 4: TARJETA --- %>
                                <div class="col-lg-6 mb-4">
                                    <div class="card bg-secondary text-light border-0 h-100">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">Mi Tarjeta Principal</h5>
                                            <div class="mt-3 flex-grow-1">
                                                <% if (resumen.tarjetaPrincipal) { %>
                                                    <i class="bi bi-credit-card-2-front-fill fs-1"
                                                        style="color: #6a0dad;"></i>
                                                    <p class="fs-5 mb-0 mt-2">
                                                        <%= resumen.tarjetaPrincipal.tipo_tarjeta %> **** <%=
                                                                resumen.tarjetaPrincipal.ultimos_cuatro_digitos %>
                                                    </p>
                                                    <small class="text-white-50">Vence: <%=
                                                            resumen.tarjetaPrincipal.fecha_expiracion %></small>
                                                    <% } else { %>
                                                        <i class="bi bi-wallet2 fs-1 text-muted"></i>
                                                        <p class="mb-0 mt-2 text-white-50">No hay tarjetas guardadas.
                                                        </p>
                                                        <% } %>
                                            </div>
                                            <%# ENLACE ARREGLADO %>
                                                <a href="/intranet/mis_tarjetas"
                                                    class="btn btn-sm btn-outline-light mt-3 align-self-start">Administrar
                                                    Tarjetas</a>
                                        </div>
                                    </div>
                                </div>
                    </div>

                    <%# --- CARD 5: ALERTA DE CUENTA (Perfil) --- %>
                        <div class="row">
                            <div class="col-12 mb-4">
                                <div class="card bg-secondary text-light border-info">
                                    <div
                                        class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
                                        <div>
                                            <h5 class="card-title text-info">⚙️ Configuración de Cuenta</h5>
                                            <p class="card-text mb-0">Mantén tus datos personales y de seguridad
                                                actualizados.</p>
                                        </div>
                                        <%# ENLACE ARREGLADO %>
                                            <a href="/intranet/configuracion"
                                                class="btn btn-info text-dark fw-bold mt-0">Ir a Configuración</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                </main>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/app_sidebar_bootstrap.js"></script>

</body>

</html>