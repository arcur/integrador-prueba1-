<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechStore - Mis Favoritos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/css/style_base.css">
</head>

<body>

    <div class="container-fluid">
        <div class="row">
            <div class="col-auto px-0">
                <%- include('partials/intranet_sidebar') %>
            </div>

            <div class="col py-3">
                <header class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                    <h1 class="futuristic-title fs-4"> </h1>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="theme-toggle">
                        <label class="form-check-label" for="theme-toggle">☀️ Modo Claro</label>
                    </div>
                </header>

                <main>
                    <h2 class="futuristic-title mb-4">Mis Productos Favoritos <i
                            class="bi bi-heart-fill text-danger"></i></h2>

                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                        <% if (favoritos.length===0) { %>
                            <div class="col-12">
                                <div class="card bg-secondary border-0 p-4 text-center">
                                    <h5 class="mb-0">No tienes ningún producto en tus favoritos.</h5>
                                </div>
                            </div>
                            <% } else { %>
                                <% favoritos.forEach(fav=> { %>
                                    <div class="col">
                                        <div class="card bg-secondary border-0 h-100">

                                            <a href="/producto/<%= fav.id_producto %>">
                                                <img src="<%= fav.imagen ? fav.imagen : '/img/placeholder-prod.webp' %>"
                                                    class="card-img-top" alt="<%= fav.nombre_producto %>"
                                                    style="height: 200px; object-fit: contain; padding: 10px;">
                                            </a>

                                            <div class="card-body d-flex flex-column">
                                                <h5 class="card-title">
                                                    <%= fav.nombre_producto %>
                                                </h5>

                                                <p class="card-text text-white-50 small">
                                                    Añadido el <%= new
                                                        Date(fav.fecha_agregado).toLocaleDateString('es-PE') %>
                                                </p>

                                                <p class="card-text fs-5 fw-bold mt-auto" style="color: #e94560;">
                                                    S/ <%= fav.precio.toFixed(2) %>
                                                </p>

                                                <div class="d-flex justify-content-between mt-2">
                                                    <a href="/producto/<%= fav.id_producto %>"
                                                        class="btn btn-sm btn-primary">Ver Producto</a>

                                                    <button class="btn btn-sm btn-outline-danger"
                                                        title="Eliminar de Favoritos">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } %>
                    </div>
                </main>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="/js/app_sidebar_bootstrap.js"></script>

</body>

</html>