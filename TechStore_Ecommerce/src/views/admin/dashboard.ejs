<%- include('partials/admin_header') %>

<% if (locals.error) { %>
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
    </div>
<% } %>

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <div class="card text-bg-success shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <i class="bi bi-cash-coin fs-1 me-3"></i>
                    <div>
                        <h5 class="card-title">Ingresos Totales</h5>
                        <h3 class="card-text">S/ <%= stats.totalIngresos.toFixed(2) %></h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card text-bg-primary shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <i class="bi bi-box-seam-fill fs-1 me-3"></i>
                    <div>
                        <h5 class="card-title">Pedidos Totales</h5>
                        <h3 class="card-text"><%= stats.totalPedidos %></h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card text-bg-info shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <i class="bi bi-people-fill fs-1 me-3"></i>
                    <div>
                        <h5 class="card-title">Clientes</h5>
                        <h3 class="card-text"><%= stats.totalClientes %></h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card text-bg-secondary shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <i class="bi bi-boxes fs-1 me-3"></i>
                    <div>
                        <h5 class="card-title">Unidades en Stock</h5>
                        <h3 class="card-text"><%= stats.stockTotalUnidades %></h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-3">
    
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <i class="bi bi-bar-chart-line-fill"></i>
                Ventas de los Últimos 7 Días
            </div>
            <div class="card-body">
                <canvas id="ventasChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <i class="bi bi-trophy-fill"></i>
                Top 5 Productos Más Vendidos
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <% if (topProductos.length === 0) { %>
                        <li class="list-group-item">Aún no hay ventas.</li>
                    <% } %>
                    
                    <% topProductos.forEach((prod, index) => { %>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <strong>#<%= index + 1 %>:</strong> <%= prod.nombre_producto %>
                            </span>
                            <span class="badge text-bg-primary rounded-pill"><%= prod.total_vendido %></span>
                        </li>
                    <% }) %>
                </ul>
            </div>
        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
   
    // Embed the serialized grafico data into a hidden DOM element to avoid parser errors with EJS tags inside script
    const graficoEl = document.createElement('div');
    graficoEl.id = 'grafico-data';
    graficoEl.style.display = 'none';
    graficoEl.dataset.labels = '<%- JSON.stringify(grafico.labels) %>';
    graficoEl.dataset.data = '<%- JSON.stringify(grafico.data) %>';
    document.body.appendChild(graficoEl);
    const labels = JSON.parse(document.getElementById('grafico-data').dataset.labels);
    const data = JSON.parse(document.getElementById('grafico-data').dataset.data);

    const ctx = document.getElementById('ventasChart');

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Ventas (S/)',
                data: data,
                backgroundColor: 'rgba(0, 123, 255, 0.7)',
                borderColor: 'rgba(0, 123, 255, 1)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true
                }
            },
            plugins: {
                legend: {
                    display: false // Ocultamos la leyenda
                }
            }
        }
    });
</script>

<%- include('partials/admin_footer') %>