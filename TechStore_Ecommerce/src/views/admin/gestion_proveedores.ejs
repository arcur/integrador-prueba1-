<%- include('partials/admin_header') %>

<% if (locals.success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
<% if (locals.error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="d-flex justify-content-end mb-3">
    <a href="/admin/proveedores/nuevo" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill"></i> Añadir Nuevo Proveedor
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Nombre Proveedor</th>
                        <th scope="col">RUC</th>
                        <th scope="col">Contacto</th>
                        <th scope="col">Dirección</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (proveedores.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center">No hay proveedores registrados.</td>
                        </tr>
                    <% } %>
                    <% proveedores.forEach(prov => { %>
                        <tr>
                            <th scope="row"><%= prov.id_proveedor %></th>
                            <td class="fw-bold"><%= prov.nombre_proveedor %></td>
                            <td><%= prov.ruc || 'N/A' %></td>
                            <td><%= prov.numero_contacto || 'N/A' %></td>
                            <td><%= prov.direccion || 'N/A' %></td>
                            <td>
                                <a href="/admin/proveedores/editar/<%= prov.id_proveedor %>" class="btn btn-warning btn-sm" title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a href="/admin/proveedores/eliminar/<%= prov.id_proveedor %>"
                                   class="btn btn-danger btn-sm" title="Eliminar"
                                   onclick="return confirm('¿Estás seguro de eliminar a <%= prov.nombre_proveedor %>? Los lotes asociados perderán la referencia al proveedor.')">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/admin_footer') %>