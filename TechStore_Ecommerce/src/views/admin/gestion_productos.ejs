<%- include('partials/admin_header') %>

<% if (locals.success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
<% if (locals.error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<%# --- Alertas de Conteo Pequeñas --- %>
<% if (conteoSinStock > 0) { %>
    <div class="alert alert-danger p-2 mb-2 d-flex align-items-center">
        <i class="bi bi-x-circle-fill me-2"></i>
        <strong>Alerta:</strong> Hay <%= conteoSinStock %> productos sin stock.
    </div>
<% } %>
<% if (conteoBajoStock > 0) { %>
    <div class="alert alert-warning p-2 mb-3 d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Aviso:</strong> Hay <%= conteoBajoStock %> productos con bajo stock (10 o menos).
    </div>
<% } %>

<%# --- Botón Añadir Producto --- %>
<div class="d-flex justify-content-end mb-3">
    <a href="/admin/productos/nuevo" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill"></i> Añadir Nuevo Producto
    </a>
</div>

<%# --- Formulario de Filtros de Stock (Servidor) --- %>
<div class="card shadow-sm mb-3">
    <div class="card-body p-3">
        <form action="/admin/productos" method="GET" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="filtro_stock" class="form-label small">Filtrar por stock:</label>
                <select name="filtro_stock" id="filtro_stock" class="form-select form-select-sm" onchange="toggleRango(this.value)">
                    <option value="todos" <%= (!filtrosActuales.filtro_stock || filtrosActuales.filtro_stock === 'todos') ? 'selected' : '' %>>Mostrar Todos</option>
                    <option value="sin_stock" <%= (filtrosActuales.filtro_stock === 'sin_stock') ? 'selected' : '' %>>Sin Stock (0)</option>
                    <option value="bajo_stock" <%= (filtrosActuales.filtro_stock === 'bajo_stock') ? 'selected' : '' %>>Stock Bajo (1-10)</option>
                    <option value="sobre_stock" <%= (filtrosActuales.filtro_stock === 'sobre_stock') ? 'selected' : '' %>>Sobrestock (>50)</option>
                    <option value="rango" <%= (filtrosActuales.filtro_stock === 'rango') ? 'selected' : '' %>>Rango manual</option>
                </select>
            </div>
            <div class="col-md-4" id="rango_inputs" style = "<%= (filtrosActuales.filtro_stock === 'rango') ? 'display: block;' : 'display: none;' %>">
                <label class="form-label small">Rango:</label>
                <div class="input-group input-group-sm">
                    <input type="number" name="stock_min" class="form-control" placeholder="Mín" value="<%= filtrosActuales.stock_min || '' %>">
                    <span class="input-group-text">-</span>
                    <input type="number" name="stock_max" class="form-control" placeholder="Máx" value="<%= filtrosActuales.stock_max || '' %>">
                </div>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-secondary btn-sm">
                    <i class="bi bi-funnel-fill"></i> Filtrar Stock
                </button>
                <a href="/admin/productos" class="btn btn-outline-secondary btn-sm" title="Limpiar filtros">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<%# --- Tabla de Productos --- %>
<div class="card shadow-sm">
    <div class="card-body">

        <%# --- INICIO DE CAMBIO: Buscador en Tiempo Real --- %>
        <div class="mb-3 col-md-6">
            <label for="realTimeSearch" class="form-label"><i class="bi bi-search"></i> Buscar por nombre (en esta lista):</label>
            <input type="text" id="realTimeSearch" class="form-control" placeholder="Escribe el nombre del producto...">
        </div>
        <%# --- FIN DE CAMBIO --- %>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Producto</th>
                        <th scope="col">Categoría</th>
                        <th scope="col">Precio (Venta)</th>
                        <th scope="col">Stock Total</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <%# Añadimos un ID al tbody para el script %>
                <tbody id="productTableBody">
                    <% productos.forEach(producto => { %>
                        <tr class="
                            <% if (producto.stock == 0) { %>
                                table-danger
                            <% } else if (producto.stock <= 10) { %>
                                table-warning
                            <% } %>
                        ">
                            <th scope="row"><%= producto.id_producto %></th>
                            <%# Añadimos una clase 'product-name' a la celda del nombre %>
                            <td class="fw-bold product-name"><%= producto.nombre_producto %></td>
                            <td><%= producto.nombre_categoria || 'N/A' %></td>
                            <td>S/ <%= producto.precio.toFixed(2) %></td>
                            
                            <td class="fw-bold fs-5">
                                <a href="/admin/productos/<%= producto.id_producto %>/lotes" 
                                   class="btn btn-outline-dark btn-sm" 
                                   title="Gestionar Lotes">
                                    <i class="bi bi-boxes"></i> <%= producto.stock %>
                                </a>
                            </td>
                            
                            <td>
                                <a href="/admin/productos/editar/<%= producto.id_producto %>" class="btn btn-warning btn-sm" title="Editar Producto">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a href="/admin/productos/<%= producto.id_producto %>/lotes/nuevo" class="btn btn-success btn-sm" title="Añadir Lote (Stock)">
                                    <i class="bi bi-plus-lg"></i>
                                </a>
                                <a href="/admin/productos/eliminar/<%= producto.id_producto %>" 
                                   class="btn btn-danger btn-sm" title="Eliminar Producto"
                                   onclick="return confirm('¿Estás seguro de que quieres eliminar este producto: <%= producto.nombre_producto %>? Se eliminarán TODOS sus lotes.')">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%# --- INICIO DE CAMBIO: Scripts --- %>
<script>
    // Script para el filtro de Rango de Stock
    function toggleRango(valor) {
        document.getElementById('rango_inputs').style.display = (valor === 'rango') ? 'block' : 'none';
    }

    // Script para el buscador en tiempo real
    document.addEventListener('DOMContentLoaded', (event) => {
        const searchInput = document.getElementById('realTimeSearch');
        const productRows = document.querySelectorAll('#productTableBody tr');

        if (searchInput) {
            searchInput.addEventListener('keyup', () => {
                const searchTerm = searchInput.value.toLowerCase().trim();

                productRows.forEach(row => {
                    // Seleccionamos la celda con la clase 'product-name'
                    const productNameCell = row.querySelector('.product-name');
                    
                    if (productNameCell) {
                        const productName = productNameCell.textContent.toLowerCase();
                        
                        // Comparamos si el nombre INCLUYE el término de búsqueda
                        if (productName.includes(searchTerm)) {
                            row.style.display = ''; // Muestra la fila
                        } else {
                            row.style.display = 'none'; // Oculta la fila
                        }
                    }
                });
            });
        }
    });
</script>
<%# --- FIN DE CAMBIO --- %>

<%- include('partials/admin_footer') %>