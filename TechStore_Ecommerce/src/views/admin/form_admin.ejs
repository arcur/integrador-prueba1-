<%- include('partials/admin_header') %>

<% if (locals.errors && errors.length > 0) { %>
    <div class="alert alert-danger" role="alert">
        <h6 class="alert-heading">Por favor, corrige los siguientes errores:</h6>
        <ul>
            <% errors.forEach(err => { %>
                <li><%= err %></li>
            <% }) %>
        </ul>
    </div>
<% } %>

<div class="card shadow-sm">
    <div class="card-body">
        <form 
            action="<%= isEditing ? '/admin/gestion-admins/editar/' + admin.id_usuario : '/admin/gestion-admins/nuevo' %>" 
            method="POST">
            
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="nombre" class="form-label">Nombre</label>
                    <input type="text" class="form-control" id="nombre" name="nombre"
                           value="<%= locals.admin ? admin.nombre : '' %>" <%= isEditing ? 'readonly' : 'required' %>>
                </div>
                <div class="col-md-4">
                    <label for="apellido_paterno" class="form-label">Apellido Paterno</label>
                    <input type="text" class="form-control" id="apellido_paterno" name="apellido_paterno"
                           value="<%= locals.admin ? admin.apellido_paterno : '' %>" <%= isEditing ? 'readonly' : 'required' %>>
                </div>
                <div class="col-md-4">
                    <label for="apellido_materno" class="form-label">Apellido Materno</label>
                    <input type="text" class="form-control" id="apellido_materno" name="apellido_materno"
                           value="<%= locals.admin ? admin.apellido_materno : '' %>" <%= isEditing ? 'readonly' : 'required' %>>
                </div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label for="numero_dni" class="form-label">DNI</label>
                    <input type="text" class="form-control" id="numero_dni" name="numero_dni"
                           value="<%= locals.admin ? admin.numero_dni : '' %>" maxlength="8" <%= isEditing ? 'readonly' : 'required' %>>
                </div>
                <div class="col-md-6">
                    <label for="telefono" class="form-label">Teléfono</label>
                    <input type="tel" class="form-control" id="telefono" name="telefono"
                           value="<%= locals.admin ? admin.telefono : '' %>" maxlength="15" <%= isEditing ? 'readonly' : '' %>>
                </div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label for="correo" class="form-label">Correo Electrónico</label>
                    <input type="email" class="form-control" id="correo" name="correo"
                           value="<%= locals.admin ? admin.correo : '' %>" <%= isEditing ? 'readonly' : 'required' %>>
                </div>
                <div class="col-md-6">
                    <label for="usuario" class="form-label">Nombre de Usuario</label>
                    <input type="text" class="form-control" id="usuario" name="usuario"
                           value="<%= locals.admin ? admin.usuario : '' %>" <%= isEditing ? 'readonly' : 'required' %>>
                </div>
            </div>

            <% if (!isEditing) { %>
                <div class="mt-3">
                    <label for="contraseña" class="form-label">Contraseña</GTC/label>
                    <input type="password" class="form-control" id="contraseña" name="contraseña" minlength="6" required>
                </div>
            <% } %>

            <hr>
            <h5 class="text-danger">Panel de Control (Solo MainAdmin)</h5>

            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label for="id_rol" class="form-label">Rol del Usuario</label>
                    <select class="form-select" id="id_rol" name="id_rol" required>
                        <% roles.forEach(rol => { %>
                            <option value="<%= rol.id_rol %>"
                                <%= (locals.admin && admin.id_rol == rol.id_rol) ? 'selected' : '' %>>
                                <%= rol.nombre_rol %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="id_estado" class="form-label">Estado del Usuario</label>
                    <select class="form-select" id="id_estado" name="id_estado" required>
                        <% states.forEach(estado => { %>
                            <option value="<%= estado.id_estado %>"
                                <%= (locals.admin && admin.id_estado == estado.id_estado) ? 'selected' : '' %>>
                                <%= estado.nombre_estado %>
                            </option>
                        <% }) %>
                    </select>
                </div>
            </div>
            
            <hr>
            
            <div class="d-flex justify-content-end">
                <a href="/admin/gestion-admins" class="btn btn-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save-fill"></i> 
                    <%= isEditing ? 'Actualizar Admin' : 'Guardar Admin' %>
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/admin_footer') %>